# Supabase Edge Function secrets (server-side only; never in the website).
# Copy to supabase/functions/.env (git-ignored), fill in, then run:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically by Supabase.

# Public site URL used in email links (no trailing slash), e.g.
# https://vvishalkumarr.github.io/habbitflows or https://habbitflows.app
SITE_URL=
# Comma-separated origins allowed to call the functions from a browser.
ALLOWED_ORIGINS=http://localhost:5173

# --- Email (password reset & recovery-email confirmation) --------------
# https://resend.com — requires a domain you own, verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=HabbitFlows <no-reply@your-domain.com>

# --- AI assistant (Anthropic Claude) ------------------------------------
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
AI_MODEL=

# --- Razorpay (web subscriptions, India) --------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Stripe (future) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Play Billing (Android) ---------------------------------------
GOOGLE_PLAY_PACKAGE_NAME=com.habbitflows.app
# Service-account JSON (one line) with access to the Play Developer API
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
