{
  "name": "habitflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "cap:sync": "npm run build && cap sync android",
    "apk:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "aab:release": "npm run cap:sync && cd android && gradlew.bat bundleRelease",
    "test:all": "node --env-file=.env scripts/test-all.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/react": "^11.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.1"
  }
}
