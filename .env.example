# =====================================================================
# HabbitFlow configuration
#
# Copy to .env for local development. Everything prefixed VITE_ is PUBLIC:
# it is compiled into the website/app bundle. Never put a secret key in a
# VITE_ variable. For the live site, set the same VITE_ values as GitHub
# repository variables (Settings -> Secrets and variables -> Actions ->
# Variables); the deploy workflow passes them to the build.
#
# Anything left empty simply switches that feature off.
# =====================================================================

# --- Supabase (required) ---------------------------------------------
# Project Settings -> API. The publishable/anon key is public by design;
# data is protected by Row Level Security (see DATABASE.md, SECURITY.md).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# --- Site ---------------------------------------------------------------
# Public URL of the website (used in emails via SITE_URL below, and links).
VITE_SITE_URL=
# Sub-path the site is served from: /habbitflow/ on GitHub Pages, / on a custom domain.
VITE_BASE_PATH=/
VITE_APP_VERSION=1.1.0
# "Support the developer" link (Buy Me a Coffee, Ko-fi, UPI page). Hidden when empty.
VITE_SUPPORT_URL=
VITE_SUPPORT_LABEL=Support the developer

# --- Legal (shown on /privacy and /terms; nothing is invented) ----------
VITE_LEGAL_BUSINESS_NAME=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_COUNTRY=
# e.g. 1 October 2026
VITE_LEGAL_EFFECTIVE_DATE=
# e.g. Japan (Tokyo) — the region of your Supabase project
VITE_LEGAL_DATA_REGION=
VITE_HOSTING_PROVIDER=
# Set to the provider actually configured for emails (e.g. Resend)
VITE_EMAIL_PROVIDER=
VITE_LEGAL_MIN_AGE=13
# Set true only after a legal professional has reviewed the texts.
VITE_LEGAL_REVIEWED=false

# --- Cookie consent -----------------------------------------------------
# all = ask everyone (default) | regional = ask EEA/UK/CH visitors only
VITE_CONSENT_MODE=all

# --- Analytics (privacy-friendly; loaded only after consent) ------------
# plausible | umami | (empty = off)
VITE_ANALYTICS_PROVIDER=
VITE_PLAUSIBLE_DOMAIN=
# VITE_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.manual.js
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=

# --- Error tracking (Sentry; scrubbed of personal data) -----------------
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_APP_ENV=production

# --- Ads (web: AdSense; loaded only with consent, never for Pro) --------
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_PROGRESS=
VITE_ADSENSE_SLOT_FRIENDS=
VITE_ADSENSE_SLOT_HELP=
# Android AdMob (not integrated yet — see MONETIZATION.md)
VITE_ADMOB_APP_ID=

# --- Payments (public identifiers only) --------------------------------
# razorpay | stripe | lemonsqueezy | (empty = no web checkout)
VITE_PAYMENT_PROVIDER=
VITE_RAZORPAY_KEY_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_GOOGLE_PLAY_PRODUCT_ID=

# --- AI assistant -------------------------------------------------------
VITE_ASSISTANT_ENABLED=true
# anthropic when ANTHROPIC_API_KEY is set on the server (used for the privacy disclosure)
VITE_AI_PROVIDER=

# --- Focus sounds (Pro) -------------------------------------------------
# Rain / white noise / ocean are generated. Forest and café need looping
# audio files you have the rights to use (e.g. CC0), hosted anywhere.
VITE_SOUND_FOREST_URL=
VITE_SOUND_CAFE_URL=

# --- Supabase CLI (local only, never committed or bundled) --------------
# Personal access token for deploying migrations and functions.
SUPABASE_ACCESS_TOKEN=

# =====================================================================
# SERVER SECRETS — do NOT put these in .env for the website.
# Set them as Supabase Edge Function secrets, e.g.:
#   npx supabase secrets set --env-file supabase/functions/.env
# using supabase/functions/.env.example as the template.
# =====================================================================
